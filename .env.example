# MamaGuard configuration.
# Copy to `.env` and fill in the values.

# ── Protocol Assistant (RAG via Groq) ────────────────────────────────────────
# Required for POST /chat. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Any chat model Groq serves; llama-3.3-70b-versatile is the default.
GROQ_MODEL=llama-3.3-70b-versatile
# How many protocol chunks to retrieve per question.
RETRIEVAL_K=5
# Cosine-distance ceiling: chunks further than this are treated as unrelated,
# so an off-topic question is refused before it ever reaches the model.
RETRIEVAL_MAX_DISTANCE=1.05


# MamaGuard email (SMTP) configuration.
# Copy this file to `.env` and fill in the values to enable email sending.
# While any of SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD is empty, the service
# runs in MOCK mode: emails are logged + printed to the terminal but NOT sent.

# --- SMTP server ---
# Port 465 = implicit SSL (recommended). Port 587 = STARTTLS, but many ISPs and
# clinic/campus networks block outbound 587, which surfaces as a connect timeout.
# If 587 times out, the service retries once on 465 automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=true

# Seconds to wait on connect/login before giving up (default 20).
SMTP_TIMEOUT=20

# --- Credentials ---
# For Gmail with 2FA, use an App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_USERNAME=your_username@gmail.com
SMTP_PASSWORD=your_app_password

# Address shown in the "From" field (defaults to SMTP_USERNAME if unset).
CLINIC_EMAIL=clinic@example.com

# Comma-separated nurse addresses for repeated-missed-appointment alerts (scheduler.py).
NURSE_EMAILS=nurse@mamaguard.local
